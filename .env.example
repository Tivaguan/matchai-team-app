# Copy to .env.local and fill in.
# These two are public (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: the project's secret key (Supabase dashboard > Settings > API keys).
SUPABASE_SECRET_KEY=

# Web push. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://team.matchai.ma

# Any long random text. Protects the weekly reminder route.
CRON_SECRET=
